BOT_TOKEN=
CLAUDE_MODEL=claude-haiku-4-5
DB_PATH=tgbot.db
WORD_THRESHOLD=15
OWNER_USER_ID=
AGENT_IDLE_SECONDS=600
AGENT_MAX_QUERIES=50

# Backend selection: claude (default) | local
TRANSLATOR_BACKEND=claude

# Per-task routing override (optional, JSON object).
# Example: route HE translation to local model, keep Russian tasks on Claude:
# TRANSLATOR_TASK_BACKENDS={"translate_to_hebrew":"local"}
TRANSLATOR_TASK_BACKENDS=

# Local LLM settings (used when TRANSLATOR_BACKEND=local or in TRANSLATOR_TASK_BACKENDS)
# Start the server: mlx_lm.server --model <model-path> --port 8080
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=dictalm3-nemotron-12b

# Pronunciation script: cyrillic (default) | latin | both
# Set to "both" during eval to compare Cyrillic vs Latin pron side-by-side.
PRON_STYLE=cyrillic
